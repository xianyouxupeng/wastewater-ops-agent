# ============================================================================
# 复制本文件为 .env 后填写密钥（.env 已被 .gitignore 排除，不会提交）
# 机制：所有供应商都走 OpenAI 兼容接口，只换 BASE_URL / KEY / MODEL，代码零改动
# LLM（对话/诊断）与 Embedding（知识库向量化）分开配置，可混搭不同供应商
# （例：DeepSeek 无 embedding API，LLM 用 DeepSeek、Embedding 用百炼/Ollama）
# ============================================================================

# ===== 当前生效：LLM = DeepSeek ｜ Embedding = 本地 Ollama =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# ============================================================================
# LLM 供应商预设 —— 换供应商 = 修改上面 LLM_ 三行，参考各块注释
# ============================================================================

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx            # https://platform.deepseek.com
# LLM_MODEL=deepseek-chat       # 或 deepseek-reasoner

# --- 阿里云百炼（Qwen 系）---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx            # https://bailian.console.aliyun.com
# LLM_MODEL=qwen-plus           # 或 qwen-max / qwen-turbo
#                               # 百炼同时有 embedding：text-embedding-v3/v4

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxx.xxx           # https://open.bigmodel.cn
# LLM_MODEL=glm-4-plus          # 或 glm-4-air / glm-4-flash(免费)

# --- 月之暗面 Kimi ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-xxx            # https://platform.moonshot.cn
# LLM_MODEL=moonshot-v1-8k      # 或 kimi 系列

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o              # 或 gpt-4o-mini

# --- 硅基流动 SiliconFlow（一个Key聚合多家模型）---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxx            # https://siliconflow.cn
# LLM_MODEL=deepseek-ai/DeepSeek-V3
#                               # 同站有免费 embedding：BAAI/bge-m3

# --- OpenRouter（海外聚合）---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-xxx            # https://openrouter.ai
# LLM_MODEL=deepseek/deepseek-chat

# --- 本地 Ollama（完全离线）---
# 先执行: ollama pull qwen2.5:14b && ollama pull bge-m3
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama            # 本地不校验，占位即可
# LLM_MODEL=qwen2.5:14b         # 按显存选 7b/14b/32b

# --- 本地 vLLM / LM Studio ---
# LLM_BASE_URL=http://localhost:8000/v1   (vLLM) 或 http://localhost:1234/v1 (LM Studio)
# LLM_API_KEY=local
# LLM_MODEL=模型名

# ============================================================================
# Embedding 供应商预设 —— 换供应商 = 修改上面 EMBED_ 三行
# ============================================================================

# --- 本地 Ollama（当前生效，免费离线）---
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3

# --- 阿里云百炼 ---
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=sk-xxx
# EMBED_MODEL=text-embedding-v3

# --- 硅基流动（免费额度）---
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=sk-xxx
# EMBED_MODEL=BAAI/bge-m3

# --- OpenAI ---
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-xxx
# EMBED_MODEL=text-embedding-3-small

# ============================================================================
# 注意：更换 Embedding 供应商后，向量维度会变化，必须删除 vector_db/ 重新 ingest
# ============================================================================
